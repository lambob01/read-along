# Copy to `.env` next to docker-compose.prod.yml on the home server.
# Compose reads `.env` automatically; it is gitignored, so it stays on the server.

# The address Caddy serves on.
#
#   reader.example.com   -> automatic HTTPS via Let's Encrypt (recommended:
#                           needs DNS pointing here and ports 80+443 reachable)
#   http://192.168.1.50  -> plain HTTP, no certificate. Note that the reader is
#                           a PWA: browsers disable service workers on non-HTTPS
#                           origins other than localhost, so offline caching and
#                           "install to home screen" stop working.
SITE_DOMAIN=reader.example.com

# How the reader's Caddy reaches Audiobookshelf. Both containers are on the
# network named in ABS_NETWORK, so this is <container-name>:<internal-port>.
# Confirm both with:
#   docker ps --format '{{.Names}}\t{{.Ports}}'
ABS_ORIGIN=http://audiobookshelf:80

# The Docker network Audiobookshelf is already attached to. Find it with:
#   docker inspect audiobookshelf --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
ABS_NETWORK=audiobookshelf_default
